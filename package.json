{
  "main": "server.js",
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/preinstall-check.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "bash scripts/start-cashcollect-mobile.sh",
    "dev:win": "powershell -ExecutionPolicy Bypass -File scripts/start-cashcollect-mobile.ps1",
    "dev:web:win": "powershell -ExecutionPolicy Bypass -File scripts/start-cashcollect-dev.ps1",
    "postmerge:win": "powershell -ExecutionPolicy Bypass -File scripts/post-merge.ps1"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
}
