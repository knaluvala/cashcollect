modules = ["nodejs-20", "nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "artifacts/cashcollect: web"

[[workflows.workflow]]
name = "artifacts/cashcollect: web"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash /home/runner/workspace/scripts/start-cashcollect-dev.sh"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/cashcollect"

[[workflows.workflow]]
name = "Start CashCollect"
mode = "sequential"
author = 60239837

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-cashcollect-mobile.sh"
waitForPort = 8082

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/cashcollect"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 23144
externalPort = 3000

[[ports]]
localPort = 23145
externalPort = 3002



[nix]
packages = ["lsof", "vim"]
channel = "stable-25_05"
