modules = ["nodejs-20", "nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[[workflows.workflow]]
name = "artifacts/cashcollect: web"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/cashcollect run dev"
cwd = "./artifacts/cashcollect"
waitForPort = 23155
router = "path"

[workflows.workflow.tasks.env]
PORT = "23155"
BASE_PATH = "/"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/cashcollect"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080

[workflows.workflow.tasks.env]
PORT = "8080"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow]]
name = "Start CashCollect"
mode = "sequential"
author = 60239837

[[workflows.workflow.tasks]]
task = "shell.exec"
#args = "bash scripts/start-cashcollect-dev.sh"
args = "bash scripts/start-cashcollect-mobile.sh"
#waitForPort = 23155
waitForPort = 8082
router = "path"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/cashcollect"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 23144
externalPort = 3000

[[ports]]
localPort = 23145
externalPort = 3002

[[ports]]
localPort = 23155
externalPort = 80

[nix]
packages = ["lsof", "vim"]
