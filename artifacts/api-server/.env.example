# Copy this file to .env and fill in the values for your environment.

# --- Required ---

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/cashcollect

# Secret used to sign/verify JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Port the API server listens on
PORT=3000

# --- Optional ---

# development | production
NODE_ENV=development

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Enables POST /auth/recover-initial-admin for one-time admin password
# recovery. Leave both unset to disable the endpoint (default/recommended).
# ADMIN_RECOVERY_TOKEN=
# ADMIN_RESET_PASSWORD=

# External collection-amount source (Settings > External Amounts used to
# read from these; only relevant if that integration is enabled)
# EXTERNAL_ACK_URL=
# EXTERNAL_ACK_TOKEN=
# EXTERNAL_COLLECTIONS_API_TOKEN=
# EXTERNAL_COLLECTIONS_ALLOWED_HOSTS=

# API key for the AI assistant service, if used
# OPENROUTER_API_KEY=
